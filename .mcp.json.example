{
  "mcpServers": {
    "outlook": {
      "command": "node",
      "args": ["/absolute/path/to/outlook-assistant/index.js"],
      "env": {
        "OUTLOOK_CLIENT_ID": "your-azure-app-client-id",
        "OUTLOOK_CLIENT_SECRET": "your-azure-app-client-secret-VALUE",
        "_comment_safety_belts": "STRONGLY recommended for AI-assisted use. The two settings below cap how many emails the AI can send per session and restrict where it can send them. Both are off by default; without them every send-email/draft-send call goes through unchecked.",
        "OUTLOOK_MAX_EMAILS_PER_SESSION": "10",
        "OUTLOOK_ALLOWED_RECIPIENTS": "your-domain.com,trusted@example.com",
        "_comment_optional": "Optional knobs:",
        "OUTLOOK_MAX_DRAFT_PER_SESSION": "20",
        "OUTLOOK_MAX_MANAGE_RULES_PER_SESSION": "5",
        "OUTLOOK_AUTH_METHOD": "device-code",
        "OUTLOOK_IMMUTABLE_IDS": "true"
      }
    }
  }
}
