{
  "name": "@littlebearapps/outlook-assistant",
  "version": "3.13.0",
  "mcpName": "io.github.littlebearapps/outlook-assistant",
  "description": "Outlook Assistant — MCP server with 22 tools for email, calendar, contacts, and settings via Microsoft Graph API",
  "main": "index.js",
  "bin": {
    "outlook-assistant": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "auth-server": "node outlook-auth-server.js",
    "test-mode": "USE_TEST_MODE=true node index.js",
    "inspect": "npx @modelcontextprotocol/inspector node index.js",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "version": "node scripts/sync-version.js && git add server.json plugins/outlook-assistant",
    "version:check": "node scripts/sync-version.js --check"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "claude",
    "outlook",
    "mcp",
    "microsoft-graph",
    "email",
    "calendar",
    "contacts",
    "model-context-protocol",
    "mcp-server",
    "anthropic",
    "outlook-assistant"
  ],
  "author": "Little Bear Apps <hello@littlebearapps.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/littlebearapps/outlook-assistant.git"
  },
  "homepage": "https://littlebearapps.com/builds/outlook-assistant",
  "bugs": {
    "url": "https://github.com/littlebearapps/outlook-assistant/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "config.js",
    "request-handler.js",
    "server.js",
    "tools.js",
    "outlook-auth-server.js",
    "auth/",
    "calendar/",
    "categories/",
    "contacts/",
    "email/",
    "folder/",
    "rules/",
    "settings/",
    "advanced/",
    "utils/",
    ".env.example",
    "README.md",
    "LICENSE",
    "llms.txt",
    "llms-install.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^2.8.0",
    "ajv": "^8.20.0",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "overrides": {
    "minimatch": ">=3.1.3",
    "hono": "^4.13.7",
    "@hono/node-server": "^1.19.17",
    "fast-uri": "^3.1.8",
    "ip-address": "^10.7.2",
    "qs": "^6.16.0",
    "body-parser": "^2.3.0"
  }
}
